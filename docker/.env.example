# Copy to .env (gitignored) and fill. Generate each secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
PAPERCLIP_PUBLIC_URL=http://localhost:3100
# LLM provider keys, only needed when running agents:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Local test admin for smoke tests (created via API on localhost only):
# DEVFLOW_TEST_ADMIN_EMAIL=
# DEVFLOW_TEST_ADMIN_PASSWORD=
