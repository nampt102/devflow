# Copy to .env (gitignored) and fill. Generate each secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
PAPERCLIP_PUBLIC_URL=http://localhost:3100
# LLM provider keys, only needed when running agents:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Local test admin for smoke tests (created via API on localhost only):
# DEVFLOW_TEST_ADMIN_EMAIL=
# DEVFLOW_TEST_ADMIN_PASSWORD=
# Set to true to close public sign-up (only after the instance has an admin; see openspec/kb/admin-accounts.md)
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# Triage agent (openspec/kb/triage-agent.md). Worker starts only when BASE_URL and MODEL are both set.
# DEVFLOW_LLM_BASE_URL=http://host:8000/v1
# DEVFLOW_LLM_MODEL=
# DEVFLOW_LLM_API_KEY=
# DEVFLOW_LLM_RESPONSE_FORMAT=json_object   # json_object | json_schema | none
