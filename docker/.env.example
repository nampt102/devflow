# Copy to .env (gitignored) and fill. Generate each secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
PAPERCLIP_PUBLIC_URL=http://localhost:3100
# LLM provider keys, only needed when running agents:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Local test admin for smoke tests (created via API on localhost only):
# DEVFLOW_TEST_ADMIN_EMAIL=
# DEVFLOW_TEST_ADMIN_PASSWORD=
# Set to true to close public sign-up (only after the instance has an admin; see openspec/kb/admin-accounts.md)
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# Triage agent (openspec/kb/triage-agent.md). Worker starts only when BASE_URL and MODEL are both set.
# DEVFLOW_LLM_BASE_URL=http://host:8000/v1
# DEVFLOW_LLM_MODEL=
# DEVFLOW_LLM_API_KEY=
# DEVFLOW_LLM_RESPONSE_FORMAT=json_object   # json_object | json_schema | none
# DEVFLOW_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}   # Qwen3 on vLLM
# Duplicate detection (bge-m3 on TEI, OpenAI-compatible /v1/embeddings). Without these only trigram is used.
# DEVFLOW_EMBED_BASE_URL=http://host.docker.internal:8080/v1
# DEVFLOW_EMBED_MODEL=
# DEVFLOW_EMBED_API_KEY=
# DEVFLOW_DEDUPE_MIN_TRIGRAM=0.3
# DEVFLOW_DEDUPE_MIN_VECTOR=0.65
# Network that re-signs TLS (Sophos, Zscaler...): put its root CA as PEM in docker/certs/ (gitignored), then
# NODE_EXTRA_CA_CERTS=/paperclip-certs/extra-ca.pem
# DEVFLOW_LLM_TEMPERATURE=0   # omitted by default (some models reject it); set 0 for vLLM
# Status emails to requesters (openspec/kb/email-notifications.md). Worker starts only when HOST and FROM are set.
# Gmail: 2-step verification + app password, host smtp.gmail.com, port 587 (SECURE=false) or 465 (SECURE=true)
# DEVFLOW_SMTP_HOST=smtp.gmail.com
# DEVFLOW_SMTP_PORT=587
# DEVFLOW_SMTP_SECURE=false
# DEVFLOW_SMTP_USER=
# DEVFLOW_SMTP_PASS=
# DEVFLOW_SMTP_FROM=DevFlow <you@example.com>
# DEVFLOW_PORTAL_BASE_URL=http://localhost:3100
# Pilot hardening (openspec/kb/runbook.md)
# PAPERCLIP_TELEMETRY_DISABLED=1          # default in the compose override: Paperclip telemetry is off
# DEVFLOW_WORKERS_ENABLED=true            # false stops Triage, embeddings and status emails at once
# DEVFLOW_TRIAGE_MAX_TOKENS_PER_DAY=500000   # per company, UTC day, Triage + embeddings; 0 = no cap
# DEVFLOW_LLM_MAX_OUTPUT_TOKENS=4000   # answers cut at this length fail as 'truncated' (1500 was too small for long Vietnamese)
# DEVFLOW_LLM_TIMEOUT_MS=60000
# Staff digest when new proposals wait for review (on whenever email is on)
# DEVFLOW_STAFF_NOTIFY_EMAILS=a@example.com,b@example.com   # empty = the company's active owners and admins
# DEVFLOW_STAFF_NOTIFY_INTERVAL_MINUTES=5                   # later proposals are gathered into one digest
# DEVFLOW_STAFF_NOTIFY_ENABLED=false                        # turn the digest off
# BA Spec agent (read-only; clones the repositories of the systems assigned to a request)
# DEVFLOW_AGENT_ANTHROPIC_API_KEY=       # used only by scripts/devflow/setup-ba-agent.mjs, stored as a company secret
# DEVFLOW_BA_MODEL=claude-haiku-5-5      # model of the BA agent
# DEVFLOW_BA_MAX_USD_PER_RUN=1           # spend limit of one run (Claude Code --max-budget-usd)
# DEVFLOW_BA_MAX_USD_PER_DAY=20          # per company, UTC day, from DevFlow's own run ledger; 0 = no cap
# DEVFLOW_BA_ENABLED=false               # turn the BA worker off (DEVFLOW_WORKERS_ENABLED=false also does)
